# ─── Nasaq Platform Configuration ───────────────────────────────────────

# MongoDB Atlas or Self-Hosted Connection URI (Optional: if omitted, defaults to smart local database in database/nasaq_local_db.json)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nasaq

# Authentication Secret (Must be at least 32 characters long)
JWT_SECRET=nasaq-platform-production-jwt-secret-key-2026-very-secure

# Base URL & Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-7727861211870198
